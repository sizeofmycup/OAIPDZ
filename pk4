import os
import time
import multiprocessing
from PIL import Image, ImageFilter

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
SRC_DIR = os.path.join(BASE_DIR, "images")
DST_DIR = os.path.join(BASE_DIR, "processed")
WIDTH, HEIGHT = 800, 600
PREFIX = "out_"


def process_image(filename):
    path = os.path.join(SRC_DIR, filename)
    img = Image.open(path)
    img = img.rotate(-90, expand=True)
    img = img.resize((WIDTH, HEIGHT), Image.LANCZOS)
    img = img.convert("L")
    out_path = os.path.join(DST_DIR, out_name(filename))
    img.save(out_path)


def out_name(filename):
    return PREFIX + filename


def sequential(files):
    for f in files:
        process_image(f)


def parallel(files):
    with multiprocessing.Pool() as pool:
        pool.map(process_image, files)


def main():
    os.makedirs(DST_DIR, exist_ok=True)
    files = [f for f in os.listdir(SRC_DIR) if f.endswith(".jpg")]

    t0 = time.perf_counter()
    sequential(files)
    t1 = time.perf_counter()
    print(f"Последовательная обработка: {t1 - t0:.4f} с")
    for f in os.listdir(DST_DIR):
        os.remove(os.path.join(DST_DIR, f))
    t0 = time.perf_counter()
    parallel(files)
    t1 = time.perf_counter()
    print(f"Параллельная обработка:    {t1 - t0:.4f} с")


if __name__ == "__main__":
    main()
